# Required: same value as RANK_WORKER_SECRET on Vercel
WORKER_SECRET=change-me

# Optional residential proxy fallback (OFF by default — DataImpulse IPs are blocked by Google)
PROXY_FALLBACK=0
PROXY_SERVER=http://gw.dataimpulse.com:10000
PROXY_USER=
PROXY_PASSWORD=

# Optional tuning (defaults shown)
# PORT=3000
# JOB_TIMEOUT_MS=18500      # keep below PHP CURLOPT_TIMEOUT (20s)
# CACHE_TTL_SECONDS=21600   # 6h
# COOLDOWN_SECONDS=600      # pause after a fresh profile is also challenged
# PAGE_GAP_MS=900
# RECYCLE_AFTER_JOBS=100   # start a fresh browser profile after N jobs
