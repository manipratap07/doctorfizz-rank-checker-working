[Unit]
Description=Doctorfizz rank checker worker (headed Chrome on Xvfb :99)
After=network-online.target xvfb99.service
Wants=network-online.target
Requires=xvfb99.service

[Service]
WorkingDirectory=/opt/doctorfizz-worker
Environment=DISPLAY=:99
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --env-file=/opt/doctorfizz-worker/.env /opt/doctorfizz-worker/server.js
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=15
StandardOutput=append:/opt/doctorfizz-worker/worker.log
StandardError=append:/opt/doctorfizz-worker/worker.log

[Install]
WantedBy=multi-user.target
